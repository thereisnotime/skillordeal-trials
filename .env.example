# Copy to .env (gitignored) or keep secrets in an existing file such as
# ~/Private/Secret/xxRC/.env and point SKILLORDEAL_ENV_FILE at it.
# Trials only ever reference the variable NAME, never the value.

# runtime.auth.mode: api_key
ANTHROPIC_API_KEY=

# runtime.auth.mode: oauth (long-lived token from `claude setup-token`).
# To use a differently named variable for one run:
#   SKILLORDEAL_TOKEN_ENV=TOC_CLAUDE_CODE_OAUTH_TOKEN just run trial=... round=...
CLAUDE_CODE_OAUTH_TOKEN=
